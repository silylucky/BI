VITALSPAN_ENV=development
DATABASE_URL=postgresql+psycopg://vitalspan:vitalspan@localhost:5432/vitalspan
# 可选：MySQL 8+ 平台元库（compose 服务 meta-mysql，宿主机 3309）
# DATABASE_URL=mysql://vitalspan:vitalspan@localhost:3309/vitalspan
# 可选：SQLite 单文件元库（开发/测试）
# DATABASE_URL=sqlite+pysqlite:///./data/vitalspan-meta.db
# JWT SM2 密钥对（国密签名）；生成：
# python ../scripts/generate-jwt-sm2-keys.py
JWT_SM2_PRIVATE_KEY=3DA75A807474C867E8E5C60B3E4E32DC8D319D4447B9594D394E6D3BD8778D1F
JWT_SM2_PUBLIC_KEY=1AE135607AEEB4D7722756BC8C736C79DE6E72452E1CF4DC32448C7393B290B946D1A7D2614DA4814F7AEDAEB92741DB46775298CDFE3D832AD5A44572ADD899
# 国密 SM4 凭证加密（固定算法）；32 位十六进制 = 16 字节密钥：
# python -c "import secrets; print(secrets.token_hex(16))"
CREDENTIAL_SM4_KEY=0123456789abcdef0123456789abcdef
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
LOG_LEVEL=INFO
# 二期查询硬上限（M1 仅占位）
QUERY_DEFAULT_LIMIT=1000
QUERY_TIMEOUT_SECONDS=30
ANALYTICS_DATABASE_URL=postgresql+psycopg://vitalspan:vitalspan@localhost:5433/analytics
# 样例源（文档注释；``SAMPLE_MYSQL_URL`` 供官方演示数据源注册解析）
# SAMPLE_MYSQL_URL=mysql+pymysql://sample:sample@localhost:3307/sample_db
# ENSURE_OFFICIAL_DEMO_DATASOURCE=1
# 报表演示种子：development 下 DEV_REPORT_SEED=1；staging 在 ENSURE_OFFICIAL_DEMO_DATASOURCE=1 时自动幂等种子
# DEV_REPORT_SEED=1
# 内置政企看板/大屏工作副本种子（默认 true；删后重启会恢复，本地调试可关）
# ENSURE_WORKSPACE_INSTANCES=false
# SAMPLE_TIMESCALEDB_URL=postgresql+psycopg://vitalspan:vitalspan@127.0.0.1:5434/ops_tsdb
#   ↑ sample-timescaledb compose 服务；CONN-013 演示/集成测；与 analytics-postgres:5433 不同库
VITALSPAN_DEV_ADMIN_PASSWORD=changeme
# AI 助手（DeepSeek 兼容 OpenAI Chat Completions；未配置 key 时助手页面会显示配置提示）
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# AGENT_MAX_TOOL_ITERATIONS=12
# AGENT_MAX_HISTORY_MESSAGES=50
# AGENT_MEMORY_RECALL_LIMIT=6
# AGENT_MEMORY_CONTEXT_MAX_CHARS=4000
# 报表调度投递（SMTP；本地可用 MailHog 1025；QQ 等需 USER/PASSWORD，587 自动 STARTTLS）
RPT_SMTP_HOST=localhost
RPT_SMTP_PORT=1025
RPT_SMTP_FROM=reports@vitalspan.local
# RPT_SMTP_USER=
# RPT_SMTP_PASSWORD=
# QQ 示例：HOST=smtp.qq.com PORT=587 FROM/USER=你的QQ@qq.com PASSWORD=授权码
# 看板可视化 PDF 导出：Playwright 访问的前端基址（须与 CORS_ORIGINS 一致）
# Windows 开发建议用 127.0.0.1，避免 localhost 命中其他 Vite 实例
FE_BASE_URL=http://127.0.0.1:5173
# Vite base path（子路径部署时填写；默认根路径留空）
# FE_BASE_PATH=my-app
# 可视化渲染失败时回落布局清单 PDF（默认 false；生产建议保持 false）
# RPT_EXPORT_FALLBACK=0
# 报表元数据/调度持久化（staging/production 建议 db；见 .env.staging.example）
# RPT_SCHEDULE_STORE=db
# RPT_METADATA_STORE=db
# ARTIFACT_STORAGE_BACKEND=fs
# ARTIFACT_STORAGE_PATH=./data/artifacts
# MailHog 本地 API（live integration 可选）
# MAILHOG_API=http://127.0.0.1:8025

# 即时通讯按人投递（发给用户资料绑的账号；群 webhook 仅「同时发到群」时使用）
# DINGTALK_APP_KEY=
# DINGTALK_APP_SECRET=
# DINGTALK_AGENT_ID=
# WECOM_CORP_ID=
# WECOM_SECRET=
# WECOM_AGENT_ID=
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# PUSH_DINGTALK_WEBHOOK=
# PUSH_WECOM_WEBHOOK=
# PUSH_FEISHU_WEBHOOK=

# 恢复数据库备份时须同时保管上述 JWT_SM2_* / CREDENTIAL_SM4_KEY 密钥（见 scripts/backup-databases.py keys-checklist.txt）
