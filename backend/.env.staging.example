# VitalSpan staging / demo — copy to backend/.env and adjust secrets.
# Differs from development defaults: report metadata + schedules persist to DB.

VITALSPAN_ENV=staging
DATABASE_URL=postgresql+psycopg://vitalspan:vitalspan@localhost:5432/vitalspan
JWT_SM2_PRIVATE_KEY=<from scripts/generate-jwt-sm2-keys.py>
JWT_SM2_PUBLIC_KEY=<from scripts/generate-jwt-sm2-keys.py>
CREDENTIAL_SM4_KEY=<32-hex-chars>
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
LOG_LEVEL=INFO

# Report center P3 persistence (required for staging sign-off)
RPT_SCHEDULE_STORE=db
RPT_METADATA_STORE=db
ARTIFACT_STORAGE_BACKEND=fs
ARTIFACT_STORAGE_PATH=./data/artifacts

# SMTP (MailHog local or real relay)
RPT_SMTP_HOST=localhost
RPT_SMTP_PORT=1025
RPT_SMTP_FROM=reports@vitalspan.local
MAILHOG_API=http://127.0.0.1:8025

# Dashboard visual PDF export
FE_BASE_URL=http://127.0.0.1:5173
RPT_EXPORT_FALLBACK=0
