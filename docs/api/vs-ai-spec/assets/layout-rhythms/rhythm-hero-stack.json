{
  "id": "rhythm-hero-stack",
  "name": "主区堆叠",
  "description": "可选 KPI 带（0～4）+ 主区 + 辅区 + 可选底条",
  "surfaceKind": "data-screen",
  "canvas": { "width": 1920, "height": 1080 },
  "contentStartY": 144,
  "marginX": 48,
  "gutter": 24,
  "shell": { "title": "数据大屏", "accent": "#22d3ee", "clock": true },
  "styleConfig": {
    "surfaceKind": "data-screen",
    "colorScheme": "dark",
    "scaleMode": "canvas",
    "gapPreset": "md",
    "widgetGap": 16,
    "pixelGutter": 24,
    "canvasBackground": "#041016",
    "canvasBackgroundCustom": true,
    "canvasDecorPresetId": "gradient-radial",
    "refreshIntervalSec": 60,
    "widgetStyle": {
      "background": "rgba(15, 23, 42, 0.78)",
      "borderColor": "#22d3ee59",
      "borderWidth": 1,
      "borderEnabled": true,
      "borderStyle": "solid",
      "borderRadius": 10
    },
    "titleStyle": { "color": "#e2e8f0", "fontSize": 14, "fontWeight": 600 },
    "chartLabelStyle": { "color": "#cbd5e1" }
  },
  "bands": [
    {
      "id": "metrics",
      "optional": true,
      "minItems": 0,
      "maxItems": 4,
      "height": 112,
      "layout": "row-equal"
    },
    {
      "id": "primary",
      "optional": false,
      "minItems": 1,
      "maxItems": 2,
      "height": 340,
      "layout": "split-2"
    },
    {
      "id": "secondary",
      "optional": true,
      "minItems": 0,
      "maxItems": 2,
      "height": 260,
      "layout": "split-2"
    },
    {
      "id": "footer",
      "optional": true,
      "minItems": 0,
      "maxItems": 1,
      "height": 120,
      "layout": "single"
    }
  ]
}
