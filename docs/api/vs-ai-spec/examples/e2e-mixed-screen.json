{
  "description": "混排大屏：内置柱图（待绑数据）+ AI 自定义组件",
  "layoutJson": {
    "version": 2,
    "canvas": { "width": 1440, "height": 1080 },
    "widgets": [
      {
        "id": "11111111-1111-4111-8111-111111111101",
        "type": "chart",
        "title": "销售对比",
        "x": 48,
        "y": 48,
        "width": 900,
        "height": 400,
        "order": 0,
        "chartConfig": {
          "chartType": "bar",
          "styleVariant": "default",
          "chartId": "11111111-1111-4111-8111-111111111101",
          "nativeBody": {
            "dataBinding": { "status": "manual" },
            "deStyle": {
              "paletteColors": ["#38bdf8", "#818cf8"],
              "cartesian": { "barRadius": 4 }
            }
          }
        }
      },
      {
        "id": "22222222-2222-4222-8222-222222222202",
        "type": "customViz",
        "title": "AI 排名条",
        "x": 1000,
        "y": 48,
        "width": 872,
        "height": 400,
        "order": 1,
        "customVizConfig": {
          "artifactId": "REPLACE_WITH_ARTIFACT_UUID",
          "dataBinding": { "status": "manual" }
        }
      }
    ],
    "globalFilters": []
  },
  "steps": [
    "POST /api/v1/ai-viz/artifacts with examples/custom-viz-bundle.json",
    "Replace REPLACE_WITH_ARTIFACT_UUID in layout",
    "PUT /api/v1/dashboards/{id}/editor-save with layoutJson",
    "Manually bind data source for chart widget in editor"
  ]
}
