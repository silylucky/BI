{
  "manifest": {
    "id": "custom-viz-trend-line-v1",
    "displayName": "动态趋势图",
    "version": "1.0.0",
    "entry": "index.html",
    "fieldSlots": {
      "dimensions": {
        "min": 1,
        "max": 1,
        "label": "时间"
      },
      "metrics": {
        "min": 1,
        "max": 1,
        "label": "数值"
      }
    },
    "styleSchema": {
      "type": "object",
      "properties": {
        "accentColor": {
          "type": "string",
          "format": "color",
          "default": "#10b981"
        },
        "lineWidth": {
          "type": "number",
          "minimum": 1,
          "maximum": 8,
          "default": 3
        },
        "showDots": {
          "type": "boolean",
          "default": true
        },
        "showArea": {
          "type": "boolean",
          "default": true
        },
        "animationDuration": {
          "type": "number",
          "minimum": 500,
          "maximum": 3000,
          "default": 1500
        },
        "curveType": {
          "type": "string",
          "enum": [
            "linear",
            "smooth"
          ],
          "default": "smooth"
        }
      }
    },
    "defaultStyle": {
      "accentColor": "#10b981",
      "lineWidth": 3,
      "showDots": true,
      "showArea": true,
      "animationDuration": 1500,
      "curveType": "smooth"
    },
    "runtime": "d3",
    "rendererHint": "d3"
  },
  "files": {
    "index.html": "<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"utf-8\">\n<style>\n:root {\n  --dashboard-artboard-bg: #0f172a;\n  --dashboard-text-primary: #e2e8f0;\n  --dashboard-text-secondary: #94a3b8;\n  --dashboard-text-muted: #64748b;\n  --dashboard-chart-grid: #334155;\n  --dashboard-widget-border: #475569;\n  --vs-trend-accent: var(--vs-style-accent-color, #10b981);\n}\nhtml, body {\n  margin: 0;\n  height: 100%;\n  background: var(--dashboard-artboard-bg);\n  color: var(--dashboard-text-primary);\n  font-family: system-ui, sans-serif;\n  overflow: hidden;\n}\n#vs-cv-chart {\n  width: 100%;\n  height: 100%;\n  position: relative;\n}\n.hint {\n  position: absolute;\n  top: 50%;\n  left: 50%;\n  transform: translate(-50%, -50%);\n  color: var(--dashboard-text-muted);\n  font-size: 12px;\n  text-align: center;\n}\n.axis text {\n  fill: var(--dashboard-text-secondary);\n  font-size: 11px;\n}\n.axis line, .axis path {\n  stroke: var(--dashboard-chart-grid);\n}\n.grid line {\n  stroke: var(--dashboard-chart-grid);\n  stroke-opacity: 0.3;\n}\n.grid path {\n  display: none;\n}\n.trend-line {\n  fill: none;\n  stroke: var(--vs-trend-accent);\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n.trend-area {\n  opacity: 0.4;\n  fill: var(--vs-trend-accent);\n}\n.data-point {\n  fill: var(--dashboard-artboard-bg);\n  stroke: var(--vs-trend-accent);\n  stroke-width: 2;\n  cursor: pointer;\n  transition: all 0.2s ease;\n}\n.data-point:hover {\n  fill: var(--vs-trend-accent);\n  transform: scale(1.5);\n}\n.tooltip {\n  position: absolute;\n  padding: 8px 12px;\n  background: rgba(15, 23, 42, 0.95);\n  border: 1px solid var(--dashboard-widget-border);\n  border-radius: 6px;\n  font-size: 12px;\n  color: var(--dashboard-text-primary);\n  pointer-events: none;\n  opacity: 0;\n  transition: opacity 0.2s;\n  z-index: 100;\n}\n.tooltip.show {\n  opacity: 1;\n}\n.value-label {\n  font-size: 11px;\n  font-weight: 600;\n  fill: var(--dashboard-text-primary);\n}\n.latest-dot {\n  fill: var(--vs-trend-accent);\n  filter: drop-shadow(0 0 4px var(--vs-trend-accent));\n  animation: pulse 2s infinite;\n}\n@keyframes pulse {\n  0%, 100% { opacity: 1; }\n  50% { opacity: 0.5; }\n}\n</style>\n</head>\n<body>\n<svg id=\"vs-cv-chart\"></svg>\n<div id=\"tooltip\" class=\"tooltip\"></div>\n<script>\n(function() {\n  var host = document.currentScript && document.currentScript.parentElement;\n  \n  function readPayload() {\n    if (host && host.vsCv && host.vsCv.getPayload) return host.vsCv.getPayload();\n    var n = (host || document).querySelector('.vs-cv-payload');\n    if (!n || !n.textContent) return null;\n    try { return JSON.parse(n.textContent); } catch (e) { return null; }\n  }\n  \n  function readStyleFromPayload(p) {\n    return (p && p.style) || {};\n  }\n  \n  function bindingStatusOf(p) {\n    if (!p) return 'unbound';\n    return p.bindingStatus || ((p.rows && p.rows.length) ? 'bound' : 'unbound');\n  }\n  \n  function statusHint(p) {\n    var st = bindingStatusOf(p);\n    if (st === 'error') return (p && p.error) || 'Data error';\n    if (st === 'empty') return 'No data';\n    if (st === 'unbound') return 'Bind time and value fields';\n    return null;\n  }\n  \n\n  \n  function dataFromPayload(p) {\n    var st = bindingStatusOf(p);\n    if (st !== 'bound' || !p || !p.rows || !p.rows.length) return null;\n    var cols = p.columns || [];\n    var di = 0, mi = 1;\n    if (cols.length >= 2) {\n      di = cols.findIndex(function(c, i) { return typeof p.rows[0][i] === 'string'; });\n      if (di < 0) di = 0;\n      mi = cols.findIndex(function(c, i) { return i !== di && typeof p.rows[0][i] === 'number'; });\n      if (mi < 0) mi = 1;\n    }\n    return p.rows.map(function(r, i) {\n      return { time: String(r[di]), value: Number(r[mi]) || 0, index: i };\n    }).filter(function(d) { return !isNaN(d.value); });\n  }\n  \n  function formatValue(v) {\n    if (v >= 1e6) return (v / 1e6).toFixed(1) + 'M';\n    if (v >= 1e3) return (v / 1e3).toFixed(1) + 'K';\n    if (v % 1 === 0) return String(v);\n    return v.toFixed(1);\n  }\n  \n  function render(payload) {\n    var vsCv = host && host.vsCv;\n    var d3 = vsCv && vsCv.d3;\n    if (!d3) return;\n    \n    var svgEl = document.getElementById('vs-cv-chart');\n    var tooltip = document.getElementById('tooltip');\n    if (!svgEl) return;\n    \n    var p = payload || readPayload();\n    var style = (p && p.style) || {};\n    var hint = statusHint(p);\n    var data = dataFromPayload(p);\n    var svg = d3.select(svgEl);\n    svg.selectAll('*').remove();\n    \n    if (hint || !data || !data.length) {\n      svg.append('text').attr('class', 'hint')\n        .attr('x', '50%').attr('y', '50%')\n        .attr('text-anchor', 'middle')\n        .text(hint || 'No data');\n      return;\n    }\n    \n    var accentColor = style.accentColor || '#10b981';\n    var lineWidth = style.lineWidth || 3;\n    var showDots = style.showDots !== false;\n    var showArea = style.showArea !== false;\n    var animDuration = style.animationDuration || 1500;\n    var isSmooth = style.curveType !== 'linear';\n    \n    svg.style('--vs-trend-accent', accentColor);\n    \n    var w = svgEl.clientWidth || 400, h = svgEl.clientHeight || 300;\n    var margin = { top: 20, right: 50, bottom: 40, left: 50 };\n    var width = w - margin.left - margin.right;\n    var height = h - margin.top - margin.bottom;\n    if (width < 50 || height < 50) return;\n    \n    var g = svg.append('g').attr('transform', 'translate(' + margin.left + ',' + margin.top + ')');\n    \n    var xScale = d3.scalePoint()\n      .domain(data.map(function(d) { return d.time; }))\n      .range([0, width])\n      .padding(0.1);\n    \n    var yMin = d3.min(data, function(d) { return d.value; });\n    var yMax = d3.max(data, function(d) { return d.value; });\n    var yPadding = (yMax - yMin) * 0.1 || yMax * 0.1;\n    var yScale = d3.scaleLinear()\n      .domain([Math.max(0, yMin - yPadding), yMax + yPadding])\n      .range([height, 0]).nice();\n    \n    var yAxis = d3.axisLeft(yScale).tickSize(-width).tickPadding(8);\n    g.append('g').attr('class', 'axis grid').call(yAxis)\n      .selectAll('line').attr('stroke', 'var(--dashboard-chart-grid)');\n    \n    var xAxis = d3.axisBottom(xScale).tickSize(0).tickPadding(10);\n    if (data.length > 10) {\n      var step = Math.ceil(data.length / 8);\n      xAxis.tickValues(data.filter(function(d, i) { return i % step === 0; }).map(function(d) { return d.time; }));\n    }\n    var xAxisG = g.append('g').attr('class', 'axis').attr('transform', 'translate(0,' + height + ')').call(xAxis);\n    xAxisG.selectAll('text').attr('transform', 'rotate(-30)').style('text-anchor', 'end');\n    \n    var lineGen = d3.line()\n      .x(function(d) { return xScale(d.time); })\n      .y(function(d) { return yScale(d.value); });\n    if (isSmooth) lineGen.curve(d3.curveCatmullRom.alpha(0.5));\n    \n    var areaGen = d3.area()\n      .x(function(d) { return xScale(d.time); })\n      .y0(height).y1(function(d) { return yScale(d.value); });\n    if (isSmooth) areaGen.curve(d3.curveCatmullRom.alpha(0.5));\n    \n    var clipPath = g.append('defs').append('clipPath').attr('id', 'clip-line')\n      .append('rect').attr('width', 0).attr('height', height);\n    \n    if (showArea) {\n      g.append('path').datum(data).attr('class', 'trend-area')\n        .attr('d', areaGen).attr('clip-path', 'url(#clip-line)');\n    }\n    \n    g.append('path').datum(data).attr('class', 'trend-line')\n      .attr('d', lineGen).attr('stroke-width', lineWidth)\n      .attr('clip-path', 'url(#clip-line)');\n    \n    clipPath.transition().duration(animDuration).ease(d3.easeCubicOut).attr('width', width);\n    \n    var last = data[data.length - 1];\n    var latestDot = g.append('circle').attr('class', 'latest-dot')\n      .attr('cx', xScale(last.time)).attr('cy', yScale(last.value)).attr('r', 0);\n    latestDot.transition().delay(animDuration * 0.8).duration(300).attr('r', 6);\n    \n    var label = g.append('text').attr('class', 'value-label')\n      .attr('x', xScale(last.time) + 12).attr('y', yScale(last.value) + 4)\n      .text(formatValue(last.value)).style('opacity', 0);\n    label.transition().delay(animDuration * 0.9).duration(300).style('opacity', 1);\n    \n    if (showDots) {\n      var dots = g.selectAll('.data-point').data(data).enter().append('circle')\n        .attr('class', 'data-point')\n        .attr('cx', function(d) { return xScale(d.time); })\n        .attr('cy', function(d) { return yScale(d.value); })\n        .attr('r', 0).style('opacity', 0);\n      \n      dots.transition()\n        .delay(function(d, i) { return (animDuration * 0.5) + (i / data.length * animDuration * 0.4); })\n        .duration(200).attr('r', 4).style('opacity', 1);\n      \n      dots.on('mouseenter', function(event, d) {\n        tooltip.innerHTML = '<strong>' + d.time + '</strong><br>' + formatValue(d.value);\n        tooltip.classList.add('show');\n        tooltip.style.left = (event.pageX + 10) + 'px';\n        tooltip.style.top = (event.pageY - 40) + 'px';\n      }).on('mouseleave', function() {\n        tooltip.classList.remove('show');\n      });\n    }\n  }\n  \n  if (host && host.vsCv && host.vsCv.mount) {\n    host.vsCv.mount(render);\n  } else {\n    render();\n  }\n})();\n</script>\n</body>\n</html>"
  }
}